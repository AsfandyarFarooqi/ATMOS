# Template for .env — copy this file to .env and fill in your own values.
# .env is git-ignored; this file is committed.

# Required: your Google Earth Engine Cloud project id
EE_PROJECT=your-earthengine-project-id

# Sampling density - higher is more accurate but slower
SAMPLE_POINTS=300
MAX_CLOUD_PCT=20

# kg/m2 per unit of the NDVI->AGB regression output.
# 0.001 = the regression outputs grams of biomass per m2 (default assumption).
AGB_MODEL_TO_KG_M2=0.001

# Parallel Earth Engine requests
MAX_WORKERS=10

# Set to 1 for Flask debug mode
FLASK_DEBUG=0